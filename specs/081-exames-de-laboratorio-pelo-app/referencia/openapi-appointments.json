                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "patient_id": {
                                        "type": "string",
                                        "example": null,
                                        "nullable": true
                                    },
                                    "appointment_time": {
                                        "type": "string",
                                        "example": "2025-04-12T15:00:00+00:00",
                                        "nullable": true
                                    },
                                    "test_location_id": {
                                        "type": "string",
                                        "example": null,
                                        "nullable": true
                                    },
                                    "confirmed": {
                                        "type": "boolean",
                                        "example": true,
                                        "nullable": true
                                    },
                                    "override_availability": {
                                        "description": "Apply the change even when the calendar reports the time as unavailable",
                                        "type": "boolean",
                                        "example": false,
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "default": {
                        "description": ""
                    }
                }
            }
        },
